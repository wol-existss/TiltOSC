# Launcher.qmlproject, Launcher.qmlproject.qtds and CMakeLists.txt.shared are
# project files
# only the ".user" variants are per-developer.

*.autosave
*.qmlproject.user
*.qmlproject.user.*
*creator.user*
*.user
*.user.*

