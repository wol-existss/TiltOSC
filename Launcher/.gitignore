
# Launcher — Qt 6 / QML / CMake / C++ desktop launcher

# Note that environment.h is generated by Qt Design Studio and NOT CMake.
# It cannot be regenerated under many circumstances and is necessary.
App/autogen/*
!App/autogen/environment.h


# CMake configure and build output

CMakeFiles/
CMakeScripts/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
DartConfiguration.tcl
Testing/
_deps/
build/
cmake-build-*/
CMakeUserPresets.json
Makefile
# QtCreator / CLion per-user CMake settings
CMakeLists.txt.user
CMakeLists.txt.user.*


# Ninja

.ninja_deps
.ninja_log
build.ninja
rules.ninja


